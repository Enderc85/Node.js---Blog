PORT=3000
NODE_ENV=development

# Clave para firmar los JWT de sesión.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=cambia_esto_por_un_secreto_aleatorio_largo

# Conexión directa a PostgreSQL (Prisma Postgres o local).
# Prisma Postgres requiere sslmode=require.
#   Local:          postgresql://usuario:contraseña@localhost:5432/blog?schema=public
#   Prisma Postgres: postgres://usuario:contraseña@db.prisma.io:5432/postgres?sslmode=require
#
# Si el host es db.prisma.io, la app usa automáticamente el serverless driver
# de Prisma Postgres (@prisma/adapter-ppg), que va por HTTP/WebSocket (443)
# y funciona aunque la red bloquee el puerto 5432.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/nombre_base_datos?schema=public"

# Alternativa: Prisma Accelerate (HTTPS 443).
# Solo se usa si defines esta variable. Ten en cuenta que Accelerate se retira
# el 1 de diciembre de 2026; el serverless driver de arriba es la opción
# recomendada para Prisma Postgres.
# ACCELERATE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
