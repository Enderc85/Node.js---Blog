    <!-- Barra de Navegación Inferior Fija para Móviles (Bottom Nav) -->
    <nav class="mobile-bottom-nav" aria-label="Navegación móvil">
        <a href="/" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active' : '' %>">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
        </a>
        <a href="/about" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'active' : '' %>">
            <i class="fa-solid fa-circle-info"></i>
            <span>About</span>
        </a>
        <a href="/contact" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/contact') ? 'active' : '' %>">
            <i class="fa-solid fa-envelope"></i>
            <span>Contacto</span>
        </a>

        <% if (typeof user !== 'undefined' && user) { %>
            <a href="/profile" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/profile') ? 'active' : '' %>">
                <i class="fa-solid fa-user-check"></i>
                <span>Perfil</span>
            </a>
        <% } else { %>
            <a href="/login" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && (currentPath === '/login' || currentPath === '/register')) ? 'active' : '' %>">
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
                <span>Cuenta</span>
            </a>
        <% } %>
    </nav>

    <footer class="text-center py-4" style="color: #64748b; font-size: 0.9rem; margin-bottom: 2rem;">
        <p>&copy; <%= new Date().getFullYear() %> Node.js Blog. Todos los derechos reservados.</p>
    </footer>
</body>

</html>
