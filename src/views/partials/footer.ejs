    <!-- Barra de Navegación Inferior Fija para Móviles (Bottom Nav) -->
    <nav class="mobile-bottom-nav" aria-label="Navegación móvil">
        <a href="/" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active' : '' %>">
            <i class="fa-solid fa-house"></i>
            <span>Home</span>
        </a>
        <a href="/about" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'active' : '' %>">
            <i class="fa-solid fa-circle-info"></i>
            <span>About</span>
        </a>

        <a href="/create-post"
            class="bottom-nav-fab <%= (typeof currentPath !== 'undefined' && currentPath === '/create-post') ? 'is-active' : '' %>"
            title="Crear un nuevo post" aria-label="Crear un nuevo post">
            <span class="bottom-nav-fab-icon"><i class="fa-solid fa-plus"></i></span>
        </a>

        <a href="/contact" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && currentPath === '/contact') ? 'active' : '' %>">
            <i class="fa-solid fa-envelope"></i>
            <span>Contacto</span>
        </a>
        <a href="/profiles" class="bottom-nav-item <%= (typeof currentPath !== 'undefined' && (currentPath === '/profiles' || currentPath === '/profile' || currentPath === '/personal')) ? 'active' : '' %>">
            <i class="fa-solid fa-users"></i>
            <span>Perfiles</span>
        </a>
    </nav>

    <footer class="site-footer">
        <p>&copy; <%= new Date().getFullYear() %> Node.js Blog. Todos los derechos reservados.</p>
    </footer>
</body>

</html>
