<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'Node.js Blog' %>
    </title>

    <!-- FontAwesome 6 y Estilos Modernos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/modern-index.css">

    <!-- Tipografías: Fraunces (display) + Manrope (UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tema oscuro Lumina: fondo tipo Telegram + tarjetas de cristal -->
    <link rel="stylesheet" href="/css/lumina-theme.css">

    <!-- Ajuste automático de proporción para las imágenes de los posts -->
    <script src="/js/media-fit.js" defer></script>

    <!-- Micro-interacción de likes (optimista con reversión si el servidor falla) -->
    <script src="/js/likes.js" defer></script>

    <!-- Paralaje del fondo de "lluvia" con la posición del cursor -->
    <script src="/js/ambient.js" defer></script>
</head>

<body data-authenticated="<%= (typeof user !== 'undefined' && user) ? 'true' : 'false' %>">

    <!-- Header / Navbar Principal (Desktop & Tablet) -->
    <header class="main-site-header">
        <div class="header-inner">
            <!-- Logo / Marca -->
            <a href="/" class="header-logo">
                <span class="logo-icon"><i class="fa-solid fa-camera-retro"></i></span>
                <span class="logo-text">Lumina<strong>Blog</strong></span>
            </a>

            <!-- Enlaces de navegación desktop -->
            <nav class="desktop-nav">
                <a href="/"
                    class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active' : '' %>">
                    <i class="fa-solid fa-house"></i>
                    <span>Home</span>
                </a>
                <a href="/profiles"
                    class="nav-link <%= (typeof currentPath !== 'undefined' && (currentPath === '/profiles' || currentPath === '/profile' || currentPath === '/personal')) ? 'active' : '' %>">
                    <i class="fa-solid fa-users"></i>
                    <span>Perfiles</span>
                </a>
                <a href="/about"
                    class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'active' : '' %>">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Sobre nosotros.</span>
                </a>
                <a href="/contact"
                    class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/contact') ? 'active' : '' %>">
                    <i class="fa-solid fa-envelope"></i>
                    <span>Contacta con nosotros</span>
                </a>
            </nav>

            <!-- Acciones de Usuario (Login / Register o Perfil) -->
            <div class="header-auth-actions">
                <% if (typeof user !=='undefined' && user) { %>
                    <!-- Usuario logueado -->
                    <a href="/create-post" id="create-post"
                        class="create-post-btn <%= (typeof currentPath !== 'undefined' && currentPath === '/create-post') ? 'active' : '' %>"
                        title="Crear un nuevo post">
                        <i class="fa-solid fa-plus"></i>
                        <span>Crea un nuevo post</span>
                    </a>
                    <% if (user.role === 'ADMIN') { %>
                        <a href="/admin"
                            class="admin-nav-btn <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/admin')) ? 'active' : '' %>"
                            title="Administración">
                            <i class="fa-solid fa-shield-halved"></i>
                            <span>Administración</span>
                        </a>
                    <% } %>
                    <a href="/personal" class="user-pill user-pill-link" title="Mi perfil">
                        <% if (user.avatar) { %>
                            <img src="<%= user.avatar %>" alt="" class="user-pill-avatar">
                        <% } else { %>
                            <i class="fa-regular fa-user"></i>
                        <% } %>
                        <span>
                            <%= user.name || user.email.split('@')[0] %>
                        </span>
                    </a>
                    <form action="/api/auth/logout" method="POST" style="margin: 0;">
                        <button type="submit" class="btn-nav-logout" title="Cerrar sesión">
                            <i class="fa-solid fa-right-from-bracket"></i>
                        </button>
                    </form>
                    <% } else { %>
                        <!-- Usuario NO logueado -->
                        <a href="/login"
                            class="btn-nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/login') ? 'active' : '' %>">
                            Iniciar sesión
                        </a>
                        <a href="/register"
                            class="btn-nav-primary <%= (typeof currentPath !== 'undefined' && currentPath === '/register') ? 'active' : '' %>">
                            Registrarse
                        </a>
                        <% } %>
            </div>
        </div>
    </header>